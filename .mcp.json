{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.2.0"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.83"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@4.21.4", "mcp"]
    }
  }
}
