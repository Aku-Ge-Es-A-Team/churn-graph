# ─── Supabase Postgres (Prisma 7) ───────────────────────────────────────────
# Ambil dari: Supabase Dashboard → project → Connect (tombol atas) → ORMs/Prisma,
# atau Project Settings → Database → Connection string.
# Ganti [PROJECT-REF], [PASSWORD], dan [REGION] sesuai project Anda.

# Transaction pooler (Supavisor, port 6543) — dipakai aplikasi saat runtime.
# WAJIB ?pgbouncer=true agar Prisma menonaktifkan prepared statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/session connection (port 5432) — dipakai `prisma migrate` & `prisma db pull`.
# DDL tidak boleh lewat transaction pooler.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

AUTH_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CERT_BUCKET=
