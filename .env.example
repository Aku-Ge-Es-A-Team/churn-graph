# Neo4j AuraDB Free (nilai asli hanya di .env.local)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Tanggal snapshot analisis (ISO)
SNAPSHOT_DATE=

# Gerbang demo Basic Auth (src/proxy.ts)
DEMO_PASSWORD=

# Key LLM (spike T00-12; nama USULAN -- dokumen hanya menulis <LLM_API_KEY sesuai provider>)
# Endpoint OpenAI-compatible milik sendiri (9router). LLM_MODEL = id persis dari GET {LLM_BASE_URL}/models
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# MCP Context7 (opsional, lihat .docs/mcp-setup.md)
CONTEXT7_API_KEY=
